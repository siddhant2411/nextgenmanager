# Copy to .env on the server and fill in. Never commit the filled-in .env.

# ── Public address ──────────────────────────────────────────────────────────
# A DNS A record for this name must point at the instance's Elastic IP before first start,
# or Caddy cannot obtain the HTTPS certificate.
DOMAIN=erp.customer-domain.com
ACME_EMAIL=you@yourcompany.com

# ── Database (RDS PostgreSQL) ───────────────────────────────────────────────
DATASOURCE_URL=jdbc:postgresql://<rds-endpoint>.ap-south-1.rds.amazonaws.com:5432/nextgenmanager?sslmode=require
DATASOURCE_USERNAME=ngm_app
DATASOURCE_PASSWORD=

# ── File storage (S3, through the MinIO client) ─────────────────────────────
MINIO_URL=https://s3.ap-south-1.amazonaws.com
MINIO_REGION=ap-south-1
MINIO_BUCKET_NAME=ngm-<customer>-files
# Access key of an IAM user that can only touch that one bucket (see README step 3).
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ── Security ────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=
# Lets an admin reset a password from the login screen. Long, random, kept by you only.
RECOVERY_SECRET=
JWT_ISSUER=https://erp.customer-domain.com
# The MCP server lets AI clients write items/BOMs. Off for customers unless they ask for it.
MCP_SERVER_ENABLED=false
MCP_SERVER_WRITE_ENABLED=false

# ── Company shown on printed documents ──────────────────────────────────────
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_GST=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_STATE=Gujarat

# ── User agreement ──────────────────────────────────────────────────────────
# Uncomment to use this customer's own agreement from ./config/user-agreement.html.
# APP_AGREEMENT_LOCATION=file:/config/user-agreement.html
# Bump whenever the agreement text changes. Every user then has to accept it again.
APP_AGREEMENT_VERSION=1.0

# ── Build ───────────────────────────────────────────────────────────────────
# Where the UI repository is checked out, relative to this directory.
UI_DIR=../../../ui
